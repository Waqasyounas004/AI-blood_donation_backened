# --- Supabase (required) -------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# --- Authentication behaviour (optional) ---------------------------------
# true  = accounts are confirmed immediately and signup returns a session.
# false = Supabase sends a confirmation email and signup returns
#         requires_email_confirmation=true with no tokens.
# Set to false once the e-mail verification workflow is implemented.
AUTH_AUTO_CONFIRM_EMAIL=true

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000